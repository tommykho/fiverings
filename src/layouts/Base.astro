---
import { u } from '../lib/url.js';
import '../styles/global.css';
import InkDefs from '../components/InkDefs.astro';
import Enso from '../components/Enso.astro';
import { SITE } from '../site.config.js';

const { title, description = SITE.description, bodyClass = '', el = 'ground' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site || SITE.url).href;
const nav = [
  { href: '/scrolls/', label: 'The Five Scrolls', match: '/scrolls' },
  { href: '/tactics/', label: 'Tactics', match: '/tactics' },
  { href: '/trial/', label: 'Dojo Trial', match: '/trial' },
  { href: '/ask/', label: 'Ask Musashi', match: '/ask', mobileOnly: true },
  { href: '/community/', label: 'Community', match: '/community' },
  { href: '/about/', label: 'About', match: '/about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0e0d0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&family=Shippori+Mincho:wght@400;600;800&family=Yuji+Syuku&display=swap"
    />
    <script is:inline src={u('/boot.js')}></script>
  </head>
  <body class={bodyClass} data-el={el}>
    <InkDefs />
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <nav class="wrap nav" aria-label="Primary">
        <a class="brand" href={u('/')} aria-label={`${SITE.name} — home`}>
          <Enso />
          <span class="brand-name">Five Rings<small>五輪書 · Modern Field Manual</small></span>
        </a>
        <ul class="nav-links" id="nav-links">
          {nav.map((n) => (
            <li class={n.mobileOnly ? 'mobile-only' : undefined}><a href={u(n.href)} aria-current={path.startsWith(u(n.match)) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
        <a class="btn btn--seal btn--sm" href={u('/ask/')}>Ask Musashi</a>
        <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" data-nav-toggle>
          <span class="sr-only">Menu</span>
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 2h16M1 7h16M1 12h11" /></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href={u('/')} style="margin-bottom:14px">
              <Enso />
              <span class="brand-name" style="color:var(--paper)">Five Rings<small>五輪書 · Modern Field Manual</small></span>
            </a>
            <p style="max-width:46ch">
              Ground, Water, Fire, Wind, Void. Five scrolls written by Miyamoto Musashi in a cave on Mount Iwato, turned into calm, practical moves for modern work and life.
            </p>
            <p class="footer-elements ja" aria-label="The five elements">
              <span data-el="ground" class="el-kanji">地</span><span data-el="water" class="el-kanji">水</span><span data-el="fire" class="el-kanji">火</span><span data-el="wind" class="el-kanji">風</span><span data-el="void" class="el-kanji">空</span>
            </p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href={u('/scrolls/')}>The five scrolls</a></li>
              <li><a href={u('/tactics/')}>Tactic library</a></li>
              <li><a href={u('/trial/')}>Dojo Trial (skill test)</a></li>
              <li><a href={u('/ask/')}>Ask Musashi (AI)</a></li>
              <li><a href={u('/community/')}>Community dojo journal</a></li>
            </ul>
          </div>
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href={u('/about/')}>Sources &amp; method</a></li>
              <li><a href={u('/about/#privacy')}>Privacy &amp; your API keys</a></li>
              <li><a href={SITE.repo} rel="noopener">Source code</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-legal">
          Original text: 五輪書 by 宮本武蔵 (1643–1645), public domain; 原文 as transcribed by 日本古典文学摘集.
          English rendering, summaries and tactics are original to this project. Tactics are general guidance, not legal, HR, medical or financial advice. Use them ethically.
        </p>
      </div>
    </footer>
    <button class="to-top" type="button" aria-label="Back to top" title="Back to top" data-to-top hidden>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 15V3M3.5 8.5 9 3l5.5 5.5" /></svg>
      <span class="to-top-zh" aria-hidden="true">空</span>
    </button>
    <script src="../scripts/motion.js"></script>
  </body>
</html>

<style>
  .footer-elements { display: flex; gap: 14px; font-size: 1.6rem; margin: 6px 0 0; }
</style>
