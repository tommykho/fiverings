---
import { u } from '../lib/url.js';
import { DOMAINS, chapterOf } from '../lib/content.js';
const { t } = Astro.props;
const ch = chapterOf(t.chapter);
const dots = '●'.repeat(t.difficulty) + '○'.repeat(3 - t.difficulty);
---
<a class="card tactic-card" href={u(`/tactics/${t.slug}/`)} data-reveal data-el={ch.key} data-domain={t.domain} data-chapter={t.chapter} data-text={`${t.title} ${t.situation} ${t.tags.join(' ')} ${t.principle}`.toLowerCase()}>
  <span class="tc-kanji el-kanji" aria-hidden="true">{ch.el.kanji}</span>
  <div class="card-meta">
    <span class="chip chip--el">{DOMAINS[t.domain]?.label} · <span class="ja">{DOMAINS[t.domain]?.ja}</span></span>
    {t.featured && <span class="chip">Founder case</span>}
  </div>
  <h3>{t.title}</h3>
  <p>{t.situation}</p>
  <div class="card-foot">
    <span>{ch.el.kanji} {ch.el.name} scroll · {t.verses.join(' · ')}</span>
    <span title={`Difficulty ${t.difficulty} of 3`} aria-label={`Difficulty ${t.difficulty} of 3`}>{dots}</span>
  </div>
</a>

<style>
  .tactic-card { padding-top: 30px; }
  .tactic-card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--el); opacity: 0.75; }
  .tactic-card::after { background: radial-gradient(circle, var(--el-soft), transparent 70%); }
  .tc-kanji { position: absolute; top: 14px; right: 18px; font-size: 2.2rem; opacity: 0.35; transition: opacity 0.4s; }
  a.tactic-card:hover .tc-kanji { opacity: 0.85; }
</style>
