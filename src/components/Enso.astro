---
// Ensō: an open brush circle, the brand mark. A small vermilion dot marks where the stroke begins.
const { size = 40, class: cls = '', ...rest } = Astro.props;
---
<svg class={`enso ${cls}`} width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true" {...rest}>
  <path d="M41 9.5C30 5.5 15 10 10.5 23c-4.6 13.3 3.6 28 17.4 31 13.6 3 25.6-5.8 27-19 .9-8.4-2.7-15.6-8.6-20.2" stroke-width="5.2" stroke-linecap="round" filter="url(#brush-tex)" />
  <circle cx="45.6" cy="13.4" r="2.6" />
</svg>
